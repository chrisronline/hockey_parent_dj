# Copy to .env for local testing (Railway: set these as service Variables instead).
# Get the Client ID + Secret from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=b473151e683d4d0d88427c55c1248041
SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Must EXACTLY match the redirect URI registered in the Spotify dashboard
# and app.json (expo.extra.spotifyRedirectUri).
SPOTIFY_REDIRECT_URI=hockeydj://callback
# Railway sets PORT automatically; only needed for local runs.
PORT=3000
