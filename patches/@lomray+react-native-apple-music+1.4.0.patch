+  /// Pull the catalog ID out of a song's play parameters. MusicKit gives no
+  /// direct catalogID on a library Song, but its `playParameters` raw JSON
+  /// carries a "catalogId" for any library track that has a catalog equivalent.
+  private static func extractCatalogId(_ params: PlayParameters?) -> String {
+    guard let params = params,
+          let data = try? JSONEncoder().encode(params),
+          let dict = try? JSONSerialization.jsonObject(with: data) as? [String: Any]
+    else {
+      return ""
+    }
+    if let catalogId = dict["catalogId"] as? String { return catalogId }
+    // Purchased (non-subscription) tracks expose it under a different key.
+    if let purchasedId = dict["purchasedId"] as? String { return purchasedId }
+    return ""
+  }
