+  func getCatalogSongs(
+    _ ids: [String],
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    let itemIds = ids.map { MusicItemID($0) }
+    Task.detached { [catalogService] in
+      do {
+        let songs = try await catalogService.fetchSongs(ids: itemIds)
+        resolve(["songs": songs])
+      } catch {
+        reject("ERROR", "Failed to fetch catalog songs: \(error)", error as NSError)
+      }
+    }
+  }
