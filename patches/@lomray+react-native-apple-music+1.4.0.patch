+  /// Fetch many catalog songs at once by their catalog IDs. Used to enrich
+  /// imported library songs with real catalog artwork (a library song's own
+  /// artwork often has no https URL and comes back blank). One request for the
+  /// whole set rather than one per song. Returns the mapped dicts in whatever
+  /// order the catalog returns them; callers key by "id" to merge.
+  func fetchSongs(ids: [MusicItemID]) async throws -> [[String: Any]] {
+    guard !ids.isEmpty else { return [] }
+    let request = MusicCatalogResourceRequest<Song>(matching: \.id, memberOf: ids)
+    let response = try await request.response()
+    return response.items.map(MusicItemMapper.map)
+  }
